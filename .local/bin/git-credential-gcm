#!/usr/bin/env bash
# Bridge git inside WSL to the Windows Git Credential Manager.
# Referenced from git config as: credential.helper = gcm

GCM_CANDIDATES=(
  "/mnt/c/Program Files/Git/mingw64/bin/git-credential-manager.exe"
  "/mnt/c/Program Files/Git/mingw64/mingw64/bin/git-credential-manager.exe"
)

for exe in "${GCM_CANDIDATES[@]}"; do
  if [[ -f "$exe" ]]; then
    exec "$exe" "$@"
  fi
done

echo "git-credential-manager.exe not found under /mnt/c. Install Git for Windows." >&2
exit 1
